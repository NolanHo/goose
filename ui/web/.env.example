# ACP Gateway + Web UI configuration.
# Copy to .env and fill in real values. .env is git-ignored.

# goosed's GOOSE_SERVER__SECRET_KEY (read from the running goosed process).
VITE_GOOSE_TOKEN=your-token-here

# Working directory for new chat sessions (goosed's cwd).
VITE_GOOSE_WORKING_DIR=/root

# Gateway port for ACP WebSocket (compression + disconnect tolerance).
VITE_GATEWAY_PORT=39249
